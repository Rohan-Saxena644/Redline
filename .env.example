APP_ORIGIN=http://localhost:3000
# Local reference login only. Production requires a trusted identity gateway (see docs).
DEV_LOGIN=true
PAYMENT_MODE=simulated
AI_MODE=fixture
LOCAL_LAB=true
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
