AI_ALLOW_LOCAL=false
# Explicit approval required before the app makes inference requests.
AI_ACCESS_APPROVED=false
# json_schema, json_object, or explicitly selected tool_calling (three bounded tools only).
# Verified Groq profile: https://api.groq.com/openai/v1 + openai/gpt-oss-20b + tool_calling.
AI_OUTPUT_MODE=json_schema
# For deployment behind a trusted authenticating proxy; never expose the origin directly.
AUTH_PROXY_SECRET=
