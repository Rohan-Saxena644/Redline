{
  "name": "redline-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides":{"minimatch":"11.0.1","esbuild":"0.28.2"},
  "engines": {
    "node": ">=22.16 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev -w @redline/web",
    "build": "npm run build -w @redline/policy && npm run build -w @redline/paypal && npm run build -w @redline/web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/integration/**",
    "test:integration": "vitest run tests/integration",
    "test:browser": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:live": "tsx scripts/verify-live.ts",
    "verify:capture": "tsx scripts/verify-capture.ts",
    "submission:manifest": "node scripts/submission-manifest.mjs"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "kysely": "0.29.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
